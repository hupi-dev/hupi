# Copy to .env (never commit the real file — it holds real secrets) and
# fill in every value below. Used by docker-compose.yml.

# Postgres superuser/admin password — used only by the `migrate` service
# to apply schema and set hupi_app's password. Pick any real secret.
POSTGRES_ADMIN_PASSWORD=

# Password for the hupi_app role (RLS-scoped, restricted — what the
# gateway actually connects as day to day). A different secret than the
# admin password above, on purpose — see schema/0004's comment on why
# the gateway never runs as the Postgres superuser.
HUPI_APP_DB_PASSWORD=

# The master encryption key, base64-encoded 32 random bytes. Generate
# with: openssl rand -base64 32
# Back this up somewhere safe outside of Postgres — losing it makes
# every encrypted episode/summary/entity permanently unreadable.
HUPI_KEK=

# Add whatever provider API key environment variables your
# providers.yaml's `api_key_env` fields reference, e.g.:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional — uncomment to require API keys for every request (Tier 3 /
# team mode). Off by default (Tier 1/2: single implicit user, no auth
# checked) — see docs/BUSINESS_PROCESS.md § "Who it's for — the three
# tiers" for what this actually changes.
# HUPI_REQUIRE_AUTH=true
