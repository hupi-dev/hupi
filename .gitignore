# Go
/bin/
.gotmp/
*.out
*.pid

# Local secrets / runtime config — never commit real values
hupi.env
providers.yaml
providers.demo.yaml
hupi.dek.wrapped
.env

# Node (cmd/hupi-admin-ui/web, site — two independent npm projects)
node_modules/
npm-debug.log*

# Astro / Vite build output — regenerated by `npm run build`, not source.
# cmd/hupi-admin-ui/web/dist is the one exception: a minimal placeholder
# index.html IS committed there so `go build` never fails on a fresh
# clone before anyone runs the npm build — see its own .gitignore for
# that narrower rule.
site/dist/
site/.astro/
cmd/hupi-admin-ui/web/.astro/

# macOS
.DS_Store

# scratch dirs used for local manual verification, never meant to persist
.scratch-verify*/
.scratch-smoketest/

# LoCoMo/LongMemEval benchmark data — fetched fresh by bench/fetch-data.sh
# from their real upstream sources (pinned commits/URLs in that script),
# not vendored, same "clone fresh, don't vendor" convention hupi-code's
# build.sh uses for microsoft/vscode.
bench/data/
