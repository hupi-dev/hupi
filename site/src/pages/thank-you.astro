---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import FinalCta from '../components/FinalCta.astro';
---

<Layout
  title="Thanks — we'll be in touch | HUPI"
  description="Your message was sent."
>
  <Nav />
  <main>
    <section class="relative overflow-hidden border-b border-white/5">
      <div
        class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_60%_60%_at_50%_0%,black,transparent)]"
      >
      </div>
      <div class="relative mx-auto max-w-2xl px-6 py-28 text-center sm:py-36">
        <p
          class="font-mono-tight mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-navy-800/60 px-4 py-1.5 text-xs uppercase tracking-widest text-fog-300"
        >
          Message sent
        </p>
        <h1 class="text-balance text-4xl font-extrabold tracking-tight text-fog-100 sm:text-5xl">
          Thanks — we'll get back to you shortly.
        </h1>
        <p class="mt-6 text-lg text-fog-300">
          In the meantime, feel free to <a href="/docs" class="text-ember-500 underline decoration-dotted hover:text-ember-400">read the docs</a>{' '}
          or <a href="/downloads" class="text-ember-500 underline decoration-dotted hover:text-ember-400">try HUPI Code</a>.
        </p>
      </div>
    </section>
  </main>
  <FinalCta />
</Layout>

<script>
  import { trackConversion } from '../lib/analytics.js';
  // This page is only ever reached by actually submitting the contact
  // form (Web3Forms' own redirect), so a page-load-based conversion
  // here is a reliable "lead form submitted" signal — more robust than
  // trying to hook the form's own submit event, since that fires before
  // Web3Forms has actually accepted the submission.
  trackConversion('leadForm');
</script>
