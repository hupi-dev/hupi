---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import FinalCta from '../components/FinalCta.astro';
import {
  VSCODE_MARKETPLACE_URL,
  HUPI_CODE_GITHUB_URL,
  HUPI_CODE_BUILD_DOCS_URL,
  HUPI_CODE_LINUX_DOWNLOAD_URL,
  HUPI_CODE_MACOS_DOWNLOAD_URL,
} from '../lib/links.js';

// HUPI Code's own per-platform build/signing/distribution status, kept
// in sync with hupi-code's README "Distribution status (Phase 4)"
// section by hand — this is marketing copy, not generated from CI, so
// it can go stale; check that README before trusting this if it's been
// a while. macOS/Linux downloadHref points at hupi-code's own CI-
// published "latest" GitHub Release (see build.yml) — always the
// current build off main, not a specific pinned version.
const platforms = [
  {
    name: 'Windows',
    status: 'Coming soon — Microsoft Store',
    body:
      "Submitted to the Microsoft Store, currently in Microsoft's certification pipeline. The Store signs the package itself during certification, so there's no separate download to trust here — once published, this becomes a normal Store install with automatic updates.",
    downloadHref: null,
    secondaryHref: null,
  },
  {
    name: 'macOS',
    status: 'Signed & notarized — download now',
    body:
      'Every push is code-signed with a real Apple Developer ID Application certificate and notarized by Apple, so this installs cleanly with no Gatekeeper warning. Apple Silicon (arm64) only for now.',
    downloadHref: HUPI_CODE_MACOS_DOWNLOAD_URL,
    downloadLabel: 'Download for macOS (.zip)',
    secondaryHref: HUPI_CODE_BUILD_DOCS_URL,
  },
  {
    name: 'Linux',
    status: 'Builds and smoke-tests in CI — download now',
    body:
      'The most exercised of the three platforms so far. x64 only for now.',
    downloadHref: HUPI_CODE_LINUX_DOWNLOAD_URL,
    downloadLabel: 'Download for Linux (.tar.gz)',
    secondaryHref: HUPI_CODE_BUILD_DOCS_URL,
  },
];
---

<Layout
  title="Downloads — HUPI in your editor, on every platform | HUPI"
  description="Install the HUPI VS Code extension today on Windows, macOS, or Linux — or track HUPI Code, the HUPI-native editor, currently in CI across all three platforms."
>
  <Nav />
  <main>
    <section class="relative overflow-hidden border-b border-white/5">
      <div
        class="bg-grid pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_60%_60%_at_50%_0%,black,transparent)]"
      >
      </div>
      <div class="relative mx-auto max-w-4xl px-6 pb-16 pt-20 text-center sm:pt-28">
        <p
          class="font-mono-tight mb-6 inline-flex items-center gap-2 rounded-full border border-white/10 bg-navy-800/60 px-4 py-1.5 text-xs uppercase tracking-widest text-fog-300"
        >
          Downloads
        </p>
        <h1 class="text-balance text-4xl font-extrabold tracking-tight text-fog-100 sm:text-5xl">
          HUPI in your editor, on every platform.
        </h1>
        <p class="text-balance mx-auto mt-6 max-w-2xl text-lg text-fog-300">
          The VS Code extension works today, everywhere VS Code runs. HUPI Code — a full
          HUPI-native editor — is being built in the open; here's exactly where each
          platform stands.
        </p>
      </div>
    </section>

    <section class="border-b border-white/5">
      <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-ember-500">
          Available now
        </h2>
        <div class="mt-6 rounded-2xl border border-white/10 bg-navy-900/60 p-8 sm:p-10">
          <p class="text-balance text-2xl font-bold text-fog-100 sm:text-3xl">
            The HUPI VS Code extension — Windows, macOS, and Linux, today.
          </p>
          <p class="mt-4 max-w-3xl leading-relaxed text-fog-300">
            A plain VS Code extension, not a fork — install it into the VS Code you already
            have, on whichever OS you already use it on. Chat sidebar, <code class="font-mono-tight rounded bg-navy-800 px-1.5 py-0.5 text-ember-400">@hupi</code> in
            the native Chat view, inline edit, inline completions, and multi-file edit, all
            backed by your own HUPI gateway instead of a vendor's.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={VSCODE_MARKETPLACE_URL}
              class="rounded-lg bg-ember-500 px-5 py-2.5 text-center text-sm font-semibold text-ink shadow-lg shadow-ember-600/20 transition-all hover:bg-ember-400"
            >
              Install from the VS Code Marketplace
            </a>
            <a
              href="/#editor"
              class="rounded-lg border border-white/15 px-5 py-2.5 text-center text-sm font-semibold text-fog-100 transition-colors hover:border-white/30 hover:bg-white/5"
            >
              See features & settings
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="border-b border-white/5 bg-navy-950/40">
      <div class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
        <h2 class="text-sm font-semibold uppercase tracking-widest text-ember-500">
          In progress
        </h2>
        <p class="text-balance mt-3 max-w-3xl text-2xl font-bold text-fog-100 sm:text-3xl">
          HUPI Code — a permanent, built-in HUPI experience, not an extension to install.
        </p>
        <p class="mt-4 max-w-3xl leading-relaxed text-fog-300">
          A HUPI-native fork of VS Code — the same chat/inline-edit experience, but bundled
          in from first launch, no install step. macOS and Linux builds are real, signed
          (macOS) downloads today, always the current build off <code class="font-mono-tight">main</code> — not
          a stable numbered release yet, and no auto-update between downloads. Windows ships
          through the Microsoft Store instead of a direct download; see why in{' '}
          <a
            href={`${HUPI_CODE_GITHUB_URL}#distribution-status-phase-4`}
            class="text-ember-400 underline decoration-dotted hover:text-ember-300"
          >
            hupi-code's README
          </a>.
        </p>

        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {
            platforms.map((p) => (
              <div class="flex flex-col rounded-xl border border-white/10 bg-navy-900/60 p-6">
                <h3 class="text-lg font-semibold text-fog-100">{p.name}</h3>
                <p class="font-mono-tight mt-2 text-xs uppercase tracking-widest text-ember-500">
                  {p.status}
                </p>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-fog-300">{p.body}</p>
                <div class="mt-5 flex flex-wrap gap-3">
                  {p.downloadHref && (
                    <a
                      href={p.downloadHref}
                      class="self-start rounded-lg bg-ember-500 px-4 py-2 text-sm font-semibold text-ink shadow-lg shadow-ember-600/20 transition-all hover:bg-ember-400"
                    >
                      {p.downloadLabel}
                    </a>
                  )}
                  {p.secondaryHref && (
                    <a
                      href={p.secondaryHref}
                      class="self-start rounded-lg border border-white/15 px-4 py-2 text-sm font-semibold text-fog-100 transition-colors hover:border-white/30 hover:bg-white/5"
                    >
                      Build from source →
                    </a>
                  )}
                </div>
              </div>
            ))
          }
        </div>

        <p class="mt-8 text-sm text-fog-300">
          Everything above is open source and built in CI on every push — see the{' '}
          <a
            href={HUPI_CODE_GITHUB_URL}
            class="text-ember-400 underline decoration-dotted hover:text-ember-300"
          >
            hupi-code repo
          </a>{' '}
          for the actual source, build scripts, and CI status, not just this summary.
        </p>
      </div>
    </section>
  </main>
  <FinalCta />
</Layout>
